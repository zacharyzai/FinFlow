# Copy this file to .env and fill in your values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Leave unset in dev — Vite proxies '/api' to localhost:8000 (see vite.config.js).
# In production, point this at the deployed FastAPI backend, e.g.:
# VITE_API_URL=https://finflow-api.up.railway.app
VITE_API_URL=
